---
import { site, waHref, defaultOrderText } from "../data/site";
import { images } from "../data/images";
import Icon from "./Icon.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const srcset = (s: string) => s.split(", ").map((x) => `${base}/${x}`).join(", ");
const img = images.storefront;
const p = site.proof;
const stampText = `Recommended on ${p.source} • `;
---
<section class="visit slats" id="visit" aria-labelledby="visit-title" style={`--slats: url(${base}/media/slats.webp)`}>
  <div class="wrap grid">
    <div class="pic">
      <div class="photo photo-zoom">
        <img
          src={`${base}/${img.src}`} srcset={srcset(img.srcset)} sizes="(min-width: 900px) 40vw, 92vw"
          width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async"
        />
      </div>
      <a class="stamp" href={p.href} target="_blank" rel="noopener"
         aria-label={`${p.recommendPct}% of ${p.reviewCount} ${p.source} reviewers recommend us. Read the reviews on ${p.source}.`}>
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="ring" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" /></defs>
          <circle cx="100" cy="100" r="96" />
          <text class="ring"><textPath href="#ring" textLength="462" lengthAdjust="spacing">{stampText}</textPath></text>
          <text class="big" x="100" y="108" text-anchor="middle">{p.recommendPct}%</text>
          <text class="small" x="100" y="134" text-anchor="middle">{p.reviewCount} reviews</text>
        </svg>
      </a>
    </div>

    <div class="info">
      <h2 id="visit-title">Come by Young Rd.</h2>
      <address>
        <a href={site.address.mapsHref} target="_blank" rel="noopener">
          {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal}
        </a>
      </address>
      <p class="patio">There are bistro tables out front when the weather's on our side.</p>
      <p class="proof">
        {p.recommendPct}% of {p.reviewCount} reviewers on {p.source} recommend us.
        <a href={p.href} target="_blank" rel="noopener">Read the reviews</a>
      </p>

      <dl>
        <div>
          <dt>Get it your way</dt>
          <dd>{site.services.join(", ")}</dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd>
            {site.hours.length
              ? site.hours.map((h) => <span class="hrs">{h.days}: {h.time}</span>)
              : <>Call ahead for today's hours: <a href={site.phone.href}>{site.phone.display}</a></>}
          </dd>
        </div>
      </dl>

      <div class="ctas">
        <a class="btn" href={site.address.mapsHref} target="_blank" rel="noopener"><Icon name="pin" /> Get directions</a>
        <a class="btn btn-line" href={waHref(defaultOrderText)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
      </div>
    </div>
  </div>
</section>

<style>
  .visit { position: relative; z-index: 3; padding-block: var(--space-6); }
  .grid { display: grid; gap: var(--space-5); align-items: center; }

  .pic { position: relative; max-width: 30rem; }
  .photo { border-radius: var(--radius-soft); aspect-ratio: 4 / 5; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }

  .stamp {
    position: absolute; right: 0.25rem; bottom: -2rem;
    width: clamp(150px, 22vw, 184px);
    transform: rotate(-10deg);
    transition: transform 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .stamp:hover { transform: rotate(-4deg) scale(1.03); } }
  @media (min-width: 900px) { .stamp { right: -1.5rem; } }
  .stamp svg { width: 100%; height: auto; }
  .stamp circle { fill: var(--pink); }
  .stamp text { fill: var(--ink); }
  .stamp .ring { font: 600 19px var(--font-body); }
  .stamp .big { font: 400 54px var(--font-display); letter-spacing: -0.02em; }
  .stamp .small { font: 600 17px var(--font-body); }

  h2 { font-size: var(--step-4); }
  address { font-style: normal; margin-top: var(--space-3); font-size: var(--step-2); line-height: 1.3; }
  address a { text-decoration-color: var(--gold); text-underline-offset: 0.2em; text-decoration-thickness: 2px; }
  .patio { margin-top: var(--space-2); }
  .proof { margin-top: var(--space-2); }
  .proof a { font-weight: 600; text-decoration-color: var(--gold); text-underline-offset: 0.2em; }

  dl { margin: var(--space-4) 0 0; display: grid; gap: var(--space-3); }
  dt { color: var(--gold); font-weight: 600; }
  dd { margin: 0.2rem 0 0; }
  dd a { font-weight: 600; }
  .hrs { display: block; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-4); }

  @media (min-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--space-6); }
  }
</style>
