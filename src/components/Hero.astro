---
import { site, nav, waHref, defaultOrderText } from "../data/site";
import { images, logo } from "../data/images";
import Icon from "./Icon.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const a = (p: string) => `${base}/${p}`;
const srcset = (s: string) => s.split(", ").map((x) => `${base}/${x}`).join(", ");
---
<section class="hero" id="top" aria-label="Welcome">
  <div class="stage">
    <picture class="media">
      <source media="(max-width: 699px)" srcset={srcset(images.heroPosterMobile.srcset)} />
      <img
        src={a(images.heroPoster.src)}
        width={images.heroPoster.width} height={images.heroPoster.height}
        alt={images.heroPoster.alt} fetchpriority="high"
      />
    </picture>
    <!-- Filled in by the script only when motion is allowed. First frame == poster, so the swap is invisible. -->
    <video class="media scrub" muted playsinline preload="none" aria-hidden="true" tabindex="-1"
      data-src={a("media/hero-push")}></video>
    <div class="scrim" aria-hidden="true"></div>

    <header class="bar wrap">
      <a class="brand" href="#top" aria-label={`${site.shortName}, back to top`}>
        <img src={a(logo.face)} width="128" height="128" alt="" />
        <span>{site.shortName}</span>
      </a>
      <nav aria-label="Sections">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="bar-call" href={site.phone.href}><Icon name="phone" /><span>{site.phone.display}</span></a>
    </header>

    <div class="copy wrap">
      <!-- Their tagline as a lockup: the handwritten lead-in signs into the serif. -->
      <h1 aria-label="A little bit from everywhere.">
        <span class="line script" aria-hidden="true">a little bit</span>
        <span class="line" aria-hidden="true">from</span>
        <span class="line" aria-hidden="true">everywhere<span class="stop">.</span></span>
      </h1>
      <p class="lede">
        Lunch and dinner to go, paninis, pastries and custom cakes, homemade on Young Rd in Chilliwack.
      </p>
      <div class="ctas">
        <a class="btn" href={waHref(defaultOrderText)} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> Order on WhatsApp
        </a>
        <a class="btn btn-line" href={site.phone.href}>
          <Icon name="phone" /> Call {site.phone.display}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --focus: var(--cream);
    --accent: var(--pink-hi);
    position: relative;
    color: var(--cream);
    background: var(--walnut);
  }
  /* Scroll room for the dolly, granted before first paint (no layout jump) and
     only when JS runs and motion is allowed. If the video fails, the sticky poster still reads fine. */
  :global(.motion) .hero { height: 230svh; }

  .stage {
    position: sticky; top: 0;
    height: 100svh; min-height: 620px;
    overflow: clip;
    display: grid; grid-template-rows: auto 1fr;
  }
  .media {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
  }
  .media img, video.media { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  video.media { opacity: 0; transition: opacity 200ms ease; }
  video.media.ready { opacity: 1; }

  /* Legibility scrim: heavier bottom-left where the type sits. */
  .scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.75) 0%, rgb(0 0 0 / 0.45) 38%, rgb(0 0 0 / 0) 70%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0) 22%),
      radial-gradient(130% 100% at 62% 40%, rgb(0 0 0 / 0) 45%, rgb(0 0 0 / 0.5) 100%); /* vignette */
  }

  .bar {
    position: relative; z-index: 2;
    display: flex; align-items: center; gap: var(--space-3);
    padding-block: var(--space-2);
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; margin-right: auto; }
  .brand img { width: 44px; height: 44px; border-radius: 50%; box-shadow: 0 0 0 2px var(--cream); }
  .brand span { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em; font-size: var(--step-1); }
  nav ul { display: flex; gap: var(--space-3); }
  nav a, .bar-call {
    text-decoration: none; font-weight: 500;
    padding-block: 0.6rem; /* 44px tap target */
    background: linear-gradient(currentColor 0 0) 0 100% / 0 2px no-repeat;
    transition: background-size 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { background-size: 100% 2px; }
  }
  .bar-call { display: inline-flex; align-items: center; gap: 0.45rem; }
  .bar-call :global(svg) { width: 1.05em; height: 1.05em; }
  @media (max-width: 899px) { nav { display: none; } }
  @media (max-width: 479px) { .bar-call span { display: none; } .bar-call { padding: 0.75rem; } }

  .copy {
    position: relative; z-index: 2;
    align-self: end;
    padding-bottom: calc(var(--space-5) + var(--scallop));
  }
  /* The lockup, a hybrid of their handwriting and the Roulé reference: a bold pink brush
     script leads into chunky, tightly set lowercase. Flush left, no stagger. */
  h1 {
    /* Scales with the phone's width so "everywhere." fills the column instead of sitting small. */
    font-size: clamp(3.4rem, 15.5vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.86;
    text-transform: none;
    text-shadow: var(--shadow-text);
  }
  .script {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: max(0.68em, 2.8rem); /* prominent enough to hold its own on a phone */
    -webkit-text-stroke: 0.6px currentColor; /* thickens the brush stroke a touch */
    line-height: 1;
    letter-spacing: 0;
    color: var(--pink-hi);
    rotate: -7deg; /* independent of the entrance animation's transform */
    transform-origin: left bottom;
    margin: 0 0 -0.04em 0.04em;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.55);
  }
  .line { display: block; }
  .lede {
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.55);
    margin-top: var(--space-3);
    max-width: 30rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-4); }

  /* The page's one orchestrated entrance: headline lines rise in, then the rest. */
  @media (prefers-reduced-motion: no-preference) {
    .line, .lede, .ctas {
      animation: rise 900ms var(--ease-out) both;
    }
    .line:nth-child(2) { animation-delay: 60ms; }
    .line:nth-child(3) { animation-delay: 120ms; }
    .lede { animation-delay: 200ms; }
    .ctas { animation-delay: 260ms; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  // Scroll-scrubbed dolly. Only runs with motion allowed and a video that actually loads;
  // otherwise the hero stays a normal-height section with the still poster.
  const hero = document.querySelector<HTMLElement>(".hero");
  const video = hero?.querySelector<HTMLVideoElement>("video.scrub");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const saveData = (navigator as any).connection?.saveData === true;

  if (hero && video && !reduce.matches && !saveData) {
    // VP9 WebM where supported (lighter), H.264 MP4 otherwise; portrait cut for phones.
    const size = window.matchMedia("(min-width: 700px)").matches ? "1280" : "720";
    const ext = video.canPlayType('video/webm; codecs="vp9"') ? "webm" : "mp4";
    video.src = `${video.dataset.src}-${size}.${ext}`;
    video.preload = "auto";

    // Stop at the frame where the CHRISRIA letters and both cases fill the shot;
    // past ~55% the generated dolly drifts into the kitchen shelving.
    const END = 0.55;
    let target = 0;
    let current = 0;
    let raf = 0;

    const progress = () => {
      const r = hero.getBoundingClientRect();
      const room = hero.offsetHeight - window.innerHeight;
      return room > 0 ? Math.min(1, Math.max(0, -r.top / room)) : 0;
    };

    const tick = () => {
      // Light smoothing so wheel steps read as a glide, not a jump.
      current += (target - current) * 0.2;
      if (Math.abs(target - current) < 0.002) current = target;
      if (Math.abs(video.currentTime - current) > 0.001) video.currentTime = current;
      raf = current === target ? 0 : requestAnimationFrame(tick);
    };

    const onScroll = () => {
      target = progress() * video.duration * END;
      if (!raf) raf = requestAnimationFrame(tick);
    };

    video.addEventListener("loadeddata", () => {
      // iOS needs a play/pause before it will paint seeked frames.
      video.play().then(() => video.pause()).catch(() => {});
      video.classList.add("ready");
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    }, { once: true });

    reduce.addEventListener("change", (e) => {
      if (!e.matches) return;
      window.removeEventListener("scroll", onScroll);
      document.documentElement.classList.remove("motion");
      video.classList.remove("ready");
    });
  }
</script>
